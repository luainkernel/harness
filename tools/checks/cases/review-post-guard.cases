# run in the directory review-post-guard.fixture.sh writes
pass	gh api -X POST repos/luainkernel/lunatik/issues/871/comments -F body=@note.md
block	gh api -X POST repos/luainkernel/lunatik/issues/871/comments -F body=@late.md
block	gh api -X POST repos/luainkernel/lunatik/issues/871/comments -F body=@line.md
pass	cd sub && gh api -X POST repos/luainkernel/lunatik/issues/871/comments -F body=@post.md
pass	gh api -X POST repos/luainkernel/lunatik/pulls/871/reviews --input review.json
block	gh api -X POST repos/luainkernel/lunatik/pulls/871/reviews --input bare.json
pass	gh issue comment 871 --body-file note.md
block	gh issue comment 871 --body-file line.md
# the words as the shell reads them: g''h joined, two spaces, a tab and a line continuation split
block	gh  issue comment 871 --body-file line.md
block	gh\tissue comment 871 --body-file line.md
block	gh 'issue' comment 871 --body-file line.md
block	gh \\nissue comment 871 --body-file line.md
block	g''h issue comment 871 --body-file line.md
pass	gh -R luainkernel/lunatik issue comment 871 --body-file note.md
block	gh -R luainkernel/lunatik issue comment 871 --body-file line.md
block	gh -Rluainkernel/lunatik pr comment 871 --body-file line.md
block	gh pr close 871 --comment done
block	gh -R luainkernel/lunatik pr close 871 --comment done
# a private repository LUNATIK_CONSUMERS lists, the origin of vault/, is named in a post to any repository but itself
# env: LUNATIK_CONSUMERS=vault
block	gh api -X POST repos/luainkernel/lunatik/issues/871/comments -F body=@vault.md
block	gh api -X POST repos/luainkernel/luaebpf/issues/3/comments -F body=@vault.md
block	gh -R luainkernel/harness issue comment 3 --body-file vault.md
pass	gh api -X POST repos/acme/vault/issues/3/comments -F body=@vault.md
pass	gh -R ACME/Vault issue comment 3 --body-file vault.md
# cwd: vault
pass	gh issue comment 3 --body-file vault.md
# cwd:

# GitHub is asked nothing, so a post on a pull request or an issue another account opened passes, through a
# gh on stub/ that answers nothing
# env: PATH=stub:/usr/local/bin:/usr/bin:/bin
pass	gh api -X POST repos/luainkernel/lunatik/issues/871/comments -F body=@note.md
pass	gh -R luainkernel/lunatik pr comment 871 --body-file note.md
