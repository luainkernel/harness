# run in the directory merge-guard.fixture.sh writes
block	gh api -X PUT repos/luainkernel/lunatik/pulls/7/merge
block	gh api -X PUT repos/luainkernel/lunatik/pulls/7/merge -f merge_method=squash
block	cd /tmp && gh api --method PUT repos/luainkernel/lunatik/pulls/7/merge -f merge_method=merge
block	gh pr merge 7 --squash
# the words as the shell reads them: g''h joined, two spaces, a tab and a line continuation split
block	gh  pr merge 7 --squash
block	gh\tpr merge 7 --squash
block	gh 'pr' merge 7 --squash
block	gh \\npr merge 7 --squash
block	g''h pr merge 7 --squash
block	gh pr merge 7
block	gh -R luainkernel/lunatik pr merge 7 --squash
block	gh -Rluainkernel/lunatik pr merge 7 --squash
block	gh pr --repo=luainkernel/lunatik merge 7 --squash
block	gh api -X PUT repos/luainkernel/lunatik/pulls/7/merge -f merge_method=squash	MERGE_OK=1
pass	MERGE_OK=1 gh api -X PUT repos/luainkernel/lunatik/pulls/7/merge -f merge_method=squash
pass	MERGE_OK=1 gh pr merge 7 --squash
pass	MERGE_OK=1 gh -R luainkernel/lunatik pr merge 7 --squash
pass	gh api repos/luainkernel/lunatik/pulls/7/merge
pass	gh api repos/luainkernel/lunatik/pulls/7 --jq .mergeable
pass	git merge --ff-only origin/master
pass	gh pr view 7
# GitHub answers through a gh on stub/ that answers only with the token in key, which the command reads
# into GH_TOKEN
# env: PATH=stub:/usr/local/bin:/usr/bin:/bin
# env: GH_TOKEN=
pass	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/7/merge -f merge_method=rebase
block	GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/7/merge -f merge_method=rebase
block	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/8/merge -f merge_method=rebase
block	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/9/merge -f merge_method=rebase
# a bump of the mount merges on the review and the CI of the commit it pins, on the harness's trunk
pass	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/10/merge -f merge_method=rebase
block	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/11/merge -f merge_method=rebase
block	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/12/merge -f merge_method=rebase
# a pull request of the harness's own repository is the harness whole, its README and its licenses too
pass	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/harness/pulls/13/merge -f merge_method=rebase
# a small pull request merges on a proof that names its head, posted by the account that opened it
pass	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/14/merge -f merge_method=rebase
block	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/15/merge -f merge_method=rebase
block	tok=$(cat key); GH_TOKEN=$tok gh api -X PUT repos/luainkernel/lunatik/pulls/16/merge -f merge_method=rebase
# the merge tools/merge.sh hands the guard, the head named and the token in GH_TOKEN, as the script exports it
# env: GH_TOKEN=cases
pass	gh api -X PUT repos/luainkernel/lunatik/pulls/7/merge -f merge_method=rebase -f sha=0123456789abcdef0123456789abcdef01234567
block	gh api -X PUT repos/luainkernel/lunatik/pulls/8/merge -f merge_method=rebase -f sha=0123456789abcdef0123456789abcdef01234567
# a repository whose CI runs no job merges on the line of its local gate the machine's environment names,
# in a comment of the posting account that names the head
block	gh api -X PUT repos/example/tools/pulls/17/merge -f merge_method=rebase -f sha=1717171717171717171717171717171717171717
# env: HARNESS_LOCAL_GATES=example/other gates: pass:[0-9]+ fail:0
block	gh api -X PUT repos/example/tools/pulls/17/merge -f merge_method=rebase -f sha=1717171717171717171717171717171717171717
# env: HARNESS_LOCAL_GATES=Example/Tools gates: pass:[0-9]+ fail:0
pass	gh api -X PUT repos/example/tools/pulls/17/merge -f merge_method=rebase -f sha=1717171717171717171717171717171717171717
block	gh api -X PUT repos/example/tools/pulls/18/merge -f merge_method=rebase -f sha=1818181818181818181818181818181818181818
block	gh api -X PUT repos/example/tools/pulls/19/merge -f merge_method=rebase -f sha=1919191919191919191919191919191919191919
pass	gh api -X PUT repos/example/tools/pulls/20/merge -f merge_method=rebase -f sha=3030303030303030303030303030303030303030
block	gh api -X PUT repos/example/tools/pulls/21/merge -f merge_method=rebase -f sha=3131313131313131313131313131313131313131
# a project that replaces the merge convention answers to a guard of its own
# cwd: replaced
pass	gh pr merge 7 --squash
# cwd:
